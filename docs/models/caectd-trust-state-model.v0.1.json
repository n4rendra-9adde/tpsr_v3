  "invariants": [
    {
      "id": "INV-001",
      "description": "TRUSTED is allowed only when: All mandatory Class A controls pass, no non-exceptionable Class B failure exists, no unresolved REVIEW_ONLY condition exists, no evidence conflict exists, required authenticated context is present and trusted, no active exception is required, and policy-blocking status is not BLOCKING."
    },
    {
      "id": "INV-002",
      "description": "CONDITIONALLY_ACCEPTED is allowed only when: All Class A controls pass, one or more exceptionable Class B failures remain visible, every mitigated failure is covered by an ACTIVE, VERIFIED_TRUSTED, exactly scoped governed exception, separation of duties passes, exception is current, required remediation and controls exist, and no REVIEW_ONLY uncertainty remains."
    },
    {
      "id": "INV-003",
      "description": "CONDITIONALLY_ACCEPTED must never be treated as TRUSTED."
    },
    {
      "id": "INV-004",
      "description": "REVIEW_REQUIRED applies when: Mandatory context is missing, trusted evidence conflicts, VEX is under investigation, context is stale, invalid, or unauthorized, evidence is insufficient for a deterministic permit/block result, or policy explicitly requires human review."
    },
    {
      "id": "INV-005",
      "description": "REJECTED applies when: Any Class A failure exists, a non-exceptionable Class B blocking failure exists, an exceptionable Class B blocking failure exists without a valid active exception, or policy explicitly requires blocking."
    },
    {
      "id": "INV-006",
      "description": "Class A non-override invariant: Missing SBOM, SBOM integrity mismatch, invalid signature, untrusted signer, signature target mismatch, missing mandatory provenance, invalid provenance envelope, unauthorized mandatory builder, repository mismatch, commit mismatch, provenance subject mismatch, evidence replay, and release-binding mismatch must always produce REJECTED regardless of VEX, context, compensating controls, or exceptions."
    }
  ],
