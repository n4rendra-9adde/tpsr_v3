      "requiredInputs": ["repositoryMatches"],
      "condition": "repositoryMatches == false",
      "effect": "REJECTED",
      "overallDecisionEffect": "REJECTED",
      "failureClass": "Class A",
      "reasonCodes": ["PRV-004"],
      "reasonCodeStatus": "EXISTING_AND_IMPLEMENTED",
      "evidenceDependencies": ["provenanceDecision"],
      "exceptionAllowed": false,
      "lifecycleEffect": "Blocked",
      "implementationStatus": "FULLY_SUPPORTED"
    },
    {
      "ruleId": "CAECTD-R011",
      "name": "Commit mismatch",
      "requiredInputs": ["sourceCommitMatches"],
      "condition": "sourceCommitMatches == false",
      "effect": "REJECTED",
      "overallDecisionEffect": "REJECTED",
      "failureClass": "Class A",
      "reasonCodes": ["PRV-004"],
      "reasonCodeStatus": "EXISTING_AND_IMPLEMENTED",
      "evidenceDependencies": ["provenanceDecision"],
      "exceptionAllowed": false,
      "lifecycleEffect": "Blocked",
      "implementationStatus": "PARTIALLY_SUPPORTED"
    },
    {
      "ruleId": "CAECTD-R012",
      "name": "Provenance subject mismatch",
      "requiredInputs": ["subjectDigestMatches"],
      "condition": "subjectDigestMatches == false",
      "effect": "REJECTED",
      "overallDecisionEffect": "REJECTED",
      "failureClass": "Class A",
      "reasonCodes": ["BND-002"],
