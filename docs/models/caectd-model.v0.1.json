  "explanationSchema": {
    "authoritative": ["decisionId", "sbomId", "releaseIdentity", "decision", "policyVersion", "trustPolicyHash", "ruleIds", "reasonCodes", "evidenceDependencies", "failureClass", "lifecycleEffect"],
    "asynchronous_anchoring": ["fabricAnchorStatus", "fabricTransactionId"],
    "informational": ["evidenceResults", "contextResults", "exceptionResult", "evaluatedBy", "evaluatedAt"]
  },
  "traceabilitySchema": ["Jenkins build", "SBOM ID", "Release digest", "Evidence IDs", "CAECTD rule IDs", "Reason codes", "Trust decision ID", "PostgreSQL history row", "Outbox ID", "Fabric transaction ID", "Lifecycle state"],
  "limitations": "Does not dynamically reevaluate based on threat intel stream. Assumes valid PKI."
}
