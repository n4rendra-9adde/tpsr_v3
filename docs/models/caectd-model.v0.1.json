{
  "modelId": "CAECTD",
  "modelVersion": "0.1",
  "modelName": "Context-Aware Evidence-Correlated Trust Decision Model",
  "releaseIdentity": {
    "sbomId": "Required, Primary Key",
    "digestManifestDigest": "Required, Cryptographic Binding Identity",
    "normalizedReleaseIdentity": "Composite Binding Identity"
  },
  "inputVectors": {
    "I": ["sbomPresent", "sbomCanonicalHashValid", "ledgerAnchorMatches", "digestManifestPresent", "signatureTargetMatches", "provenanceSubjectMatches", "vexScopeMatches", "contextTargetMatches", "exceptionScopeMatches"],
    "S": ["signaturePresent", "cryptographicSignatureValid", "verificationMode", "signerIdentity", "signerFingerprint", "signerTrusted", "transparencyLogVerified", "signatureFresh", "signatureReplayStatus"],
    "P": ["provenancePresent", "envelopeSignatureValid", "predicateSupported", "subjectDigestMatches", "builderIdentity", "builderTrusted", "repositoryMatches", "sourceCommitMatches", "buildTypeTrusted", "provenanceFresh", "provenanceReplayStatus"],
    "V": ["vulnerabilityCount", "originalVulnerabilityId", "originalCvssScore", "originalSeverity", "vexAvailable", "vexSignatureValid", "vexIssuerTrusted", "vexScopeMatches", "vexStatus", "vexJustificationAccepted", "vexFresh", "applicabilityDisposition", "policyBlockingStatus"],
    "C": ["environment", "internetExposure", "assetCriticality", "privilegeLevel", "dataSensitivity", "runtimeExecution", "componentPresence", "compensatingControls", "contextAssertedBy", "contextAssertedAt", "contextJustification", "contextExpiry", "contextTrusted", "exceptionPresent", "exceptionOwner", "exceptionApprover", "exceptionJustification", "exceptionScope", "exceptionCreatedAt", "exceptionExpiresAt", "exceptionActive"]
  },
  "assuranceStates": ["VERIFIED_TRUSTED", "VERIFIED_UNTRUSTED", "INVALID", "MISSING", "STALE", "REPLAYED", "CONFLICTING", "NOT_APPLICABLE", "NOT_EVALUATED"],
  "failureClasses": ["Class A", "Class B", "Class C", "Class D"],
  "trustStates": ["TRUSTED", "CONDITIONALLY_ACCEPTED", "REVIEW_REQUIRED", "REJECTED"],
  "precedence": ["REJECTED", "REVIEW_REQUIRED", "CONDITIONALLY_ACCEPTED", "TRUSTED"],
  "evaluationOrder": [
    "Validate release identity",
    "Evaluate non-overridable authenticity controls",
    "Evaluate cross-evidence binding",
    "Evaluate freshness and replay",
    "Evaluate vulnerability applicability",
    "Evaluate deployment context",
    "Evaluate policy exceptions",
    "Apply decision precedence"
  ],
  "contextEnumerations": {
    "environment": ["DEVELOPMENT", "TEST", "STAGING", "PRODUCTION"],
    "exploitability": ["EXPLOITABLE", "NOT_EXPLOITABLE", "UNDER_INVESTIGATION", "UNKNOWN"],
    "assetCriticality": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
    "internetExposure": ["NONE", "INTERNAL", "RESTRICTED_PUBLIC", "PUBLIC"],
    "privilegeLevel": ["UNPRIVILEGED", "ELEVATED", "SYSTEM"],
    "dataSensitivity": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"],
    "runtimeExecution": ["EXECUTED", "PRESENT_NOT_EXECUTED", "NOT_PRESENT", "UNKNOWN"],
    "exceptionStatus": ["NONE", "ACTIVE", "EXPIRED", "REVOKED", "OUT_OF_SCOPE", "INVALID"]
  },
  "evidenceDependencies": {
    "signatureDecision": ["signaturePresent", "cryptographicSignatureValid", "signerTrusted", "signatureTargetBoundToRelease"],
    "provenanceDecision": ["envelopeSignatureValid", "signerOrBuilderTrusted", "predicateFormatSupported", "provenanceSubjectBoundToRelease", "repositoryAndCommitAccepted", "evidenceFresh", "replayCheckPassed"],
    "vexApplicabilityDecision": ["originalVulnerabilityExists", "vexDocumentStructurallyValid", "vexSignatureValid", "vexIssuerTrusted", "productMatch", "releaseMatch", "componentMatch", "vulnerabilityMatch", "justificationAccepted", "vexCurrent", "vexNotRevokedOrConflicting"],
    "contextualPolicyDecision": ["trustedContextAssertion", "contextTargetMatchesRelease", "environmentValuesValid", "applicableVulnerabilityResults", "exceptionValidityWhereUsed"],
    "conditionallyAccepted": ["mandatoryControlsPass", "remainingPolicyViolationExists", "correctlyScopedExceptionExists", "exceptionOwnerAndApproverAuthorized", "exceptionUnexpired", "exceptionDoesNotOverrideNonExceptionableFailure"]
  },
  "rules": [
    {
      "ruleId": "CAECTD-R001",
      "name": "Missing SBOM",
      "requiredInputs": ["sbomPresent"],
      "condition": "sbomPresent == false",
      "effect": "REJECTED",
      "overallDecisionEffect": "REJECTED",
      "failureClass": "Class A",
      "reasonCodes": ["INT-002"],
      "reasonCodeStatus": "EXISTING_AND_IMPLEMENTED",
      "evidenceDependencies": ["integrity"],
      "exceptionAllowed": false,
      "lifecycleEffect": "Blocked",
      "implementationStatus": "FULLY_SUPPORTED"
    },
    {
      "ruleId": "CAECTD-R002",
      "name": "SBOM integrity canonical hash mismatch",
      "requiredInputs": ["sbomCanonicalHashValid"],
      "condition": "sbomCanonicalHashValid == false",
      "effect": "REJECTED",
      "overallDecisionEffect": "REJECTED",
      "failureClass": "Class A",
      "reasonCodes": ["INT-004", "INT-005"],
      "reasonCodeStatus": "EXISTING_AND_IMPLEMENTED",
      "evidenceDependencies": ["integrity"],
      "exceptionAllowed": false,
      "lifecycleEffect": "Blocked",
      "implementationStatus": "FULLY_SUPPORTED"
    },
    {
      "ruleId": "CAECTD-R003",
      "name": "Missing mandatory signature",
      "requiredInputs": ["signaturePresent"],
      "condition": "signaturePresent == false",
      "effect": "REJECTED",
      "overallDecisionEffect": "REJECTED",
      "failureClass": "Class A",
      "reasonCodes": ["SIG-002"],
      "reasonCodeStatus": "EXISTING_AND_IMPLEMENTED",
      "evidenceDependencies": ["signatureDecision"],
      "exceptionAllowed": false,
      "lifecycleEffect": "Blocked",
      "implementationStatus": "FULLY_SUPPORTED"
    },
    {
      "ruleId": "CAECTD-R004",
      "name": "Invalid cryptographic signature",
      "requiredInputs": ["cryptographicSignatureValid"],
      "condition": "cryptographicSignatureValid == false",
      "effect": "REJECTED",
      "overallDecisionEffect": "REJECTED",
      "failureClass": "Class A",
      "reasonCodes": ["SIG-002"],
      "reasonCodeStatus": "EXISTING_AND_IMPLEMENTED",
      "evidenceDependencies": ["signatureDecision"],
      "exceptionAllowed": false,
      "lifecycleEffect": "Blocked",
      "implementationStatus": "FULLY_SUPPORTED"
    },
    {
      "ruleId": "CAECTD-R005",
      "name": "Valid signature from untrusted signer",
      "requiredInputs": ["signerTrusted"],
      "condition": "signerTrusted == false",
      "effect": "REJECTED",
      "overallDecisionEffect": "REJECTED",
      "failureClass": "Class A",
      "reasonCodes": ["SIG-003"],
      "reasonCodeStatus": "EXISTING_AND_IMPLEMENTED",
      "evidenceDependencies": ["signatureDecision"],
      "exceptionAllowed": false,
      "lifecycleEffect": "Blocked",
      "implementationStatus": "FULLY_SUPPORTED"
    },
    {
      "ruleId": "CAECTD-R006",
      "name": "Signature target mismatch",
      "requiredInputs": ["signatureTargetMatches"],
      "condition": "signatureTargetMatches == false",
      "effect": "REJECTED",
      "overallDecisionEffect": "REJECTED",
      "failureClass": "Class A",
      "reasonCodes": ["BND-003"],
      "reasonCodeStatus": "EXISTING_AND_IMPLEMENTED",
      "evidenceDependencies": ["signatureDecision"],
      "exceptionAllowed": false,
      "lifecycleEffect": "Blocked",
      "implementationStatus": "FULLY_SUPPORTED"
    },
    {
      "ruleId": "CAECTD-R007",
      "name": "Missing mandatory provenance",
      "requiredInputs": ["provenancePresent"],
      "condition": "provenancePresent == false",
      "effect": "REJECTED",
      "overallDecisionEffect": "REJECTED",
      "failureClass": "Class A",
      "reasonCodes": ["PRV-005"],
      "reasonCodeStatus": "EXISTING_AND_IMPLEMENTED",
      "evidenceDependencies": ["provenanceDecision"],
      "exceptionAllowed": false,
      "lifecycleEffect": "Blocked",
      "implementationStatus": "FULLY_SUPPORTED"
    },
    {
      "ruleId": "CAECTD-R008",
      "name": "Invalid provenance envelope",
      "requiredInputs": ["envelopeSignatureValid"],
      "condition": "envelopeSignatureValid == false",
      "effect": "REJECTED",
      "overallDecisionEffect": "REJECTED",
      "failureClass": "Class A",
      "reasonCodes": ["PRV-002"],
      "reasonCodeStatus": "EXISTING_AND_IMPLEMENTED",
      "evidenceDependencies": ["provenanceDecision"],
      "exceptionAllowed": false,
      "lifecycleEffect": "Blocked",
      "implementationStatus": "FULLY_SUPPORTED"
    },
    {
      "ruleId": "CAECTD-R009",
