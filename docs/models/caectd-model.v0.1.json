      "overallDecisionEffect": "TRUSTED",
      "failureClass": "None",
      "reasonCodes": ["GOV-001"],
      "reasonCodeStatus": "EXISTING_AND_IMPLEMENTED",
      "evidenceDependencies": ["conditionallyAccepted", "contextualPolicyDecision", "vexApplicabilityDecision", "provenanceDecision", "signatureDecision"],
