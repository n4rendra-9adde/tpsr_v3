      "condition": "vexSignatureValid == false",
      "effect": "REJECTED",
      "overallDecisionEffect": "REJECTED",
      "failureClass": "Class A",
      "reasonCodes": ["VEX-010"],
      "reasonCodeStatus": "PROPOSED",
      "evidenceDependencies": ["vexApplicabilityDecision"],
      "exceptionAllowed": false,
      "lifecycleEffect": "Blocked",
      "implementationStatus": "FULLY_SUPPORTED"
    },
    {
      "ruleId": "CAECTD-R021",
      "name": "Valid VEX from untrusted issuer",
      "requiredInputs": ["vexIssuerTrusted", "vexSignatureValid"],
      "condition": "vexIssuerTrusted == false && vexSignatureValid == true",
      "effect": "REVIEW_REQUIRED",
      "overallDecisionEffect": "REVIEW_REQUIRED",
      "failureClass": "Class C",
      "reasonCodes": ["VEX-002"],
      "reasonCodeStatus": "EXISTING_AND_IMPLEMENTED",
      "evidenceDependencies": ["vexApplicabilityDecision"],
      "exceptionAllowed": true,
      "lifecycleEffect": "Blocked",
      "implementationStatus": "FULLY_SUPPORTED"
    },
    {
      "ruleId": "CAECTD-R022",
