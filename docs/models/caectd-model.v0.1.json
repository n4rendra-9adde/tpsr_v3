      "reasonCodes": ["PROPOSED"],
      "reasonCodeStatus": "PROPOSED",
      "evidenceDependencies": ["provenanceDecision"],
      "exceptionAllowed": true,
      "lifecycleEffect": "Blocked",
      "implementationStatus": "NOT_SUPPORTED"
    },
    {
      "ruleId": "CAECTD-R015",
      "name": "Replayed evidence",
      "requiredInputs": ["signatureReplayStatus", "provenanceReplayStatus"],
      "condition": "signatureReplayStatus == REPLAYED || provenanceReplayStatus == REPLAYED",
      "effect": "REJECTED",
      "overallDecisionEffect": "REJECTED",
      "failureClass": "Class A",
      "reasonCodes": ["PROPOSED"],
      "reasonCodeStatus": "PROPOSED",
      "evidenceDependencies": ["signatureDecision", "provenanceDecision"],
      "exceptionAllowed": false,
      "lifecycleEffect": "Blocked",
      "implementationStatus": "NOT_SUPPORTED"
    },
    {
      "ruleId": "CAECTD-R016",
      "name": "Trusted NOT_AFFECTED VEX",
      "requiredInputs": ["vexStatus", "vexIssuerTrusted", "vexSignatureValid"],
      "condition": "vexStatus == NOT_AFFECTED && vexIssuerTrusted == true && vexSignatureValid == true",
      "effect": "NON_BLOCKING",
      "overallDecisionEffect": "None",
      "failureClass": "None",
      "reasonCodes": ["VEX-001"],
      "reasonCodeStatus": "EXISTING_AND_IMPLEMENTED",
      "evidenceDependencies": ["vexApplicabilityDecision"],
      "exceptionAllowed": true,
      "lifecycleEffect": "None",
      "implementationStatus": "FULLY_SUPPORTED"
    },
    {
      "ruleId": "CAECTD-R017",
      "name": "Affected critical vulnerability in PRODUCTION",
      "requiredInputs": ["environment", "originalSeverity", "policyBlockingStatus"],
      "condition": "environment == PRODUCTION && originalSeverity == CRITICAL && policyBlockingStatus == BLOCKING",
      "effect": "REJECTED",
      "overallDecisionEffect": "REJECTED",
      "failureClass": "Class B",
      "reasonCodes": ["CTX-002"],
      "reasonCodeStatus": "EXISTING_AND_IMPLEMENTED",
      "evidenceDependencies": ["contextualPolicyDecision"],
      "exceptionAllowed": true,
      "lifecycleEffect": "Blocked",
      "implementationStatus": "FULLY_SUPPORTED"
    },
    {
      "ruleId": "CAECTD-R018",
      "name": "Affected critical vulnerability in DEVELOPMENT",
      "requiredInputs": ["environment", "originalSeverity", "policyBlockingStatus"],
      "condition": "environment == DEVELOPMENT && originalSeverity == CRITICAL && policyBlockingStatus == BLOCKING",
      "effect": "REVIEW_REQUIRED",
      "overallDecisionEffect": "REVIEW_REQUIRED",
      "failureClass": "Class C",
      "reasonCodes": ["PROPOSED"],
      "reasonCodeStatus": "PROPOSED",
