    "vexEvidenceIds": "array",
    "vulnerabilityIds": "array",
    "componentIdentifiers": "array",
    "triggeredRuleIds": "array",
    "evaluatedRuleIds": "array",
    "reasonCodes": "array",
    "evidenceDependencies": "array",
    "conflictResults": "array",
    "evaluatedAt": "string"
  },
  "limitations": [
    "Latency does not measure end-to-end network performance."
  ]
}
